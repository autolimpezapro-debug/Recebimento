    { "src": "assets/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Contagem de inventário", "short_name": "Contagem", "description": "Contar itens (funciona offline)", "url": "./?page=contagens&origem=atalho", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Chegadas / NF pendente", "short_name": "Chegadas", "description": "Registrar material ou nota sem par", "url": "./?page=chegadas&origem=atalho", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Estoque", "short_name": "Estoque", "description": "Saldo, entrada e saída de material", "url": "./?page=estoque&origem=atalho", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Pedidos / Recebimento", "short_name": "Pedidos", "description": "Conferir recebimento de pedidos", "url": "./?page=pedidos&origem=atalho", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
